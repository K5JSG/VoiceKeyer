<Window x:Class="VoiceKeyer.UI.TrainerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice trainer - record your voice" Style="{StaticResource DialogWindow}" Width="760" Height="560"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Voice name " VerticalAlignment="Center"/>
            <TextBox x:Name="VoiceName" Grid.Column="1" Padding="3" Text="MyVoice" LostFocus="VoiceName_LostFocus"
                     ToolTip="Letters, digits and underscores only"/>
            <TextBlock Text="  Microphone " Grid.Column="2" VerticalAlignment="Center"/>
            <ComboBox x:Name="Microphone" Grid.Column="3" IsEditable="False"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DimBrush}" FontSize="12"
                       Text="Use a quiet room and keep the microphone the same distance for every line. Read each prompt naturally at the pace you normally use on the air. Aim for at least 150 clips (about 15 minutes); 250 or more sounds better. Press Space to start and stop. You can stop any time and continue later."/>
            <ProgressBar x:Name="Level" Height="8" Minimum="0" Maximum="1" Margin="0,10,0,0" Foreground="#4CAF50" Background="#33363B"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,12" Background="#1B1D20" CornerRadius="8" Padding="22">
            <TextBlock x:Name="PromptText" FontSize="26" TextWrapping="Wrap" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextAlignment="Center" Foreground="White"/>
        </Border>

        <TextBlock x:Name="Progress" Grid.Row="3" Margin="0,0,0,8" Foreground="{StaticResource DimBrush}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="PrevButton" Content="&#x25C0; Prev" Width="80" Height="34" Click="Prev_Click"/>
            <Button x:Name="RecordButton" Content="&#x25CF; Record (Space)" Width="150" Height="34" Margin="8,0" Click="Record_Click"
                    Background="#B03A2E" Foreground="White"/>
            <Button x:Name="PlayButton" Content="&#x25B6; Play" Width="80" Height="34" Click="Play_Click"/>
            <Button x:Name="NextButton" Content="Next &#x25B6;" Width="80" Height="34" Margin="8,0,0,0" Click="Next_Click"/>
            <Button Content="Export for training..." Width="150" Height="34" Margin="24,0,0,0" Click="Export_Click"
                    ToolTip="Creates a .zip to upload to the Colab training notebook"/>
            <Button Content="Open folder" Width="90" Height="34" Margin="8,0,0,0" Click="OpenFolder_Click"/>
        </StackPanel>
    </Grid>
</Window>
