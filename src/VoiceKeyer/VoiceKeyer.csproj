<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VoiceKeyer</AssemblyName>
    <Product>Voice Keyer</Product>
    <AssemblyTitle>Voice Keyer</AssemblyTitle>
    <Company>K5JSG</Company>
    <Version>1.3.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window icons (see the DialogWindow style in App.xaml). Logo.png is the full-size source artwork, kept here, not shipped. -->
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Piper text-to-speech engine and a stock voice, shipped beside VoiceKeyer.exe so the app is self-contained. -->
    <!-- ExcludeFromSingleFile: without it a single-file publish swallows piper.exe and its DLLs into VoiceKeyer.exe, where Piper cannot run them. -->
    <Content Include="Bundled\piper\**" Link="piper\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Bundled\voices\**" Link="voices\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- The Colab notebook the voice trainer hands to the user on export. -->
    <Content Include="..\..\trainer\Piper_Voice_Trainer.ipynb" Link="trainer\Piper_Voice_Trainer.ipynb" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.2.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
  </ItemGroup>

</Project>
